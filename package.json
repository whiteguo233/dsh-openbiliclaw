{
  "name": "@openbiliclaw/dsh-plugin",
  "description": "OpenBiliClaw for DSH: a sidebar recommendation panel (feed, library, dialogue, profile, settings) plus 22 Agent Bridge tools, so the agent can read recommendations, answer probes and close the loop. OpenBiliClaw DSH \u5ba2\u6237\u7aef\u63d2\u4ef6\uff1a\u4fa7\u8fb9\u680f\u63a8\u8350\u9762\u677f + 22 \u4e2a Agent Bridge \u5de5\u5177\u3002",
  "version": "0.6.3",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteguo233/dsh-openbiliclaw.git"
  },
  "homepage": "https://github.com/whiteguo233/dsh-openbiliclaw#readme",
  "bugs": {
    "url": "https://github.com/whiteguo233/dsh-openbiliclaw/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openbiliclaw",
    "bilibili",
    "recommendation",
    "agent-bridge"
  ],
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "skills"
  ],
  "license": "BSD-3-Clause"
}
